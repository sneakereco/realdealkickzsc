{
  "engines": {
    "node": "^24.14.1"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "doppler run -- next dev",
    "build": "next build",
    "start": "doppler run -- next start",
    "gen:types": "npx supabase gen types typescript --local --schema public > src/types/db/database.types.ts",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:admin-readonly": "tsx --test tests/admin-catalog-read-only.test.ts",
    "test:catalog-only": "tsx --test tests/catalog-only-purchase.test.tsx",
    "test:workflows": "node --test tests/workflows/ci-workflow.test.mjs tests/workflows/staging-workflow.test.mjs tests/workflows/production-workflow.test.mjs",
    "test:lightspeed": "node --import tsx --test tests/lightspeed-webhooks.test.ts",
    "test:analytics": "node --test tests/cloudflare-analytics.test.mjs",
    "test:docs": "node --test tests/documentation.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.81.1",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.35.6",
    "jose": "^6.1.2",
    "lucide-react": "^0.562.0",
    "next": "^16.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-scrollbar-hide": "^4.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.0.3",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "supabase": "^2.117.0",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.4"
  }
}
